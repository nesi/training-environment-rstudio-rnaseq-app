#!/usr/bin/env bash

#
# Start RStudio Server
#
# PAM auth helper used by RStudio
export WORKING_DIR="<%= session.staged_root %>"
export RSTUDIO_AUTH="$WORKING_DIR/bin/auth"

export PATH="$PATH:/usr/lib/rstudio-server/bin"

# RStudioServer doesn't inherit "ulimit -s" from system config /etc/security/limits.d/custom.conf
# Therefore, we are setting it here

ulimit -s unlimited

# Generate an `rsession` wrapper script
export RSESSION_WRAPPER_FILE="$WORKING_DIR/rsession.sh"
(
umask 077
sed 's/^ \{2\}//' > "$WORKING_DIR/rsession.sh" << EOL
  #!/usr/bin/env bash

  # Log all output from this script
  export RSESSION_LOG_FILE="$WORKING_DIR/rsession.log"

  exec &>>"\${RSESSION_LOG_FILE}"

  # rsession.sh doesn't share the same env as the outside script, so these
  # need to be set explicitly
  export TZ="Pacific/Auckland"
  export PATH="/usr/local/bin:$PATH"

  #This is to resolve issue : https://github.com/nesi/nesi-ood-rstudio-server-app/issues/13
  if [ ! -f ~/.inputrc ] || ! grep -qF 'set enable-bracketed-paste off' ~/.inputrc; then
      echo 'set enable-bracketed-paste off' >> ~/.inputrc
  fi

  # Launch the original command
  echo "Launching rsession..."
  set -x
  exec rsession "\${@}"
EOL
)
chmod 700 "$WORKING_DIR/rsession.sh"
mkdir -p "$WORKING_DIR/logs"
mkdir -p /tmp/rserver-run

cd $HOME

set -x
echo "Starting up rserver..."

# copy the selected workshop dataset into ~/RNA_seq
stage-rnaseq-data "${RNASEQ_DATASET:-nz}"

# RStudio starts in the home directory. v0.5.0-v0.5.1 wrote an initial working
# directory of ~/RNA_seq into the user's prefs; remove exactly that setting so
# those users land in home too, leaving any other prefs (and any directory the
# user chose themselves) alone.
RSTUDIO_PREFS=~/.config/rstudio/rstudio-prefs.json
if [ -f "${RSTUDIO_PREFS}" ] && jq -e '.initial_working_directory == "~/RNA_seq"' "${RSTUDIO_PREFS}" > /dev/null 2>&1; then
    jq 'del(.initial_working_directory)' "${RSTUDIO_PREFS}" > "${RSTUDIO_PREFS}.tmp" && mv "${RSTUDIO_PREFS}.tmp" "${RSTUDIO_PREFS}"
fi

# launch rserver
rserver \
    --www-port=8080 \
    --auth-none=0 \
    --auth-pam-helper-path="${RSTUDIO_AUTH}" \
    --auth-encrypt-password=0 \
    --auth-timeout-minutes=0 \
    --database-config-file='/etc/rstudio/database/database.conf' \
    --server-data-dir='/tmp/rserver-run' \
    --server-daemonize=0 \
    --server-user=$(whoami) \
    --rsession-path "${RSESSION_WRAPPER_FILE}" \
    --server-app-armor-enabled=0